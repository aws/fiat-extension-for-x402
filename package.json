{
  "name": "aws-agent-pay-x402",
  "version": "0.1.0",
  "description": "AWS Agent Pay extension for x402 protocol",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./facilitator": {
      "types": "./dist/facilitator.d.ts",
      "import": "./dist/facilitator.js",
      "require": "./dist/facilitator.cjs"
    },
    "./agent-pay/client": {
      "types": "./dist/agent-pay/client/index.d.ts",
      "import": "./dist/agent-pay/client/index.js",
      "require": "./dist/agent-pay/client/index.cjs"
    },
    "./agent-pay/server": {
      "types": "./dist/agent-pay/server/index.d.ts",
      "import": "./dist/agent-pay/server/index.js",
      "require": "./dist/agent-pay/server/index.cjs"
    },
    "./agent-pay/facilitator": {
      "types": "./dist/agent-pay/facilitator/index.d.ts",
      "import": "./dist/agent-pay/facilitator/index.js",
      "require": "./dist/agent-pay/facilitator/index.cjs"
    },
    "./middleware/express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/middleware/express.js",
      "require": "./dist/middleware/express.cjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "npm run test:coverage && open coverage/index.html",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "deps:list": "npx license-checker --production --csv | awk -F',' 'NR>1 {gsub(/\"/,\"\"); print $1\"-\"$2}' > deps.txt",
    "deps:licenses": "npx generate-license-file --input package.json --output licenses.txt"
  },
  "keywords": [
    "x402",
    "fab",
    "payment",
    "billing",
    "http-402",
    "fiat",
    "agent-pay"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.0.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-kms": "^3.1045.0",
    "@aws-sdk/credential-providers": "^3.1045.0",
    "@aws-sdk/types": "^3.973.8",
    "@smithy/protocol-http": "^5.4.1",
    "@smithy/signature-v4": "^5.4.1",
    "@smithy/types": "^4.14.1",
    "jose": "^5.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@x402/core": "^2.0.0",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git.amazon.com/pkg/AgentPayX402SDKExtension-Typescript"
  },
  "homepage": "https://code.amazon.com/packages/AgentPayX402SDKExtension-Typescript"
}

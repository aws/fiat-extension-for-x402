{
  "name": "aws-agent-pay-x402",
  "version": "0.1.0",
  "description": "AWS Agent Pay extension for x402 protocol",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent-pay/client": {
      "import": {
        "types": "./dist/agent-pay/client/index.d.ts",
        "default": "./dist/agent-pay/client/index.js"
      },
      "require": {
        "types": "./dist/agent-pay/client/index.d.cts",
        "default": "./dist/agent-pay/client/index.cjs"
      }
    },
    "./agent-pay/server": {
      "import": {
        "types": "./dist/agent-pay/server/index.d.ts",
        "default": "./dist/agent-pay/server/index.js"
      },
      "require": {
        "types": "./dist/agent-pay/server/index.d.cts",
        "default": "./dist/agent-pay/server/index.cjs"
      }
    },
    "./agent-pay/facilitator": {
      "import": {
        "types": "./dist/agent-pay/facilitator/index.d.ts",
        "default": "./dist/agent-pay/facilitator/index.js"
      },
      "require": {
        "types": "./dist/agent-pay/facilitator/index.d.cts",
        "default": "./dist/agent-pay/facilitator/index.cjs"
      }
    },
    "./middleware/express": {
      "import": {
        "types": "./dist/middleware/express.d.ts",
        "default": "./dist/middleware/express.js"
      },
      "require": {
        "types": "./dist/middleware/express.d.cts",
        "default": "./dist/middleware/express.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "npm run test:coverage && open coverage/index.html",
    "build": "tsup",
    "attw": "npm run build && attw --pack . --profile node16",
    "publint": "npm run build && publint",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 120",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "deps:list": "npx license-checker --production --csv | awk -F',' 'NR>1 {gsub(/\"/,\"\"); print $1\"-\"$2}' > deps.txt",
    "deps:licenses": "npx generate-license-file --input package.json --output licenses.txt"
  },
  "keywords": [
    "x402",
    "fab",
    "payment",
    "billing",
    "http-402",
    "fiat",
    "agent-pay"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.0.0"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    }
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-kms": "^3.1143.0",
    "@aws-sdk/credential-providers": "^3.1143.0",
    "@aws-sdk/types": "^3.973.8",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.4.1",
    "@smithy/types": "^4.14.1",
    "jose": "^5.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-secrets-manager": "^3.1143.0",
    "@eslint/js": "9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "@x402/core": "^2.0.0",
    "eslint": "9.39.5",
    "express": "^4.18.2",
    "prettier": "^3.9.9",
    "publint": "0.3.25",
    "tsup": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git.amazon.com/pkg/AgentPayX402SDKExtension-Typescript"
  },
  "homepage": "https://code.amazon.com/packages/AgentPayX402SDKExtension-Typescript"
}

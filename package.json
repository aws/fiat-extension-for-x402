{
  "name": "@aws/fiat-extension-for-x402",
  "version": "1.0.0",
  "description": "AWS Marketplace Agentic Commerce payment schemes for the x402 protocol",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agentic-commerce/exact": {
      "import": {
        "types": "./dist/agentic-commerce/exact/index.d.ts",
        "default": "./dist/agentic-commerce/exact/index.js"
      },
      "require": {
        "types": "./dist/agentic-commerce/exact/index.d.cts",
        "default": "./dist/agentic-commerce/exact/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "npm run test:coverage && open coverage/index.html",
    "build": "tsup",
    "attw": "attw --pack . --profile node16",
    "publint": "publint",
    "check:package": "npm run build && npm run attw && npm run publint",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint src test examples --max-warnings 21",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "deps:list": "npx license-checker --production --csv | awk -F',' 'NR>1 {gsub(/\"/,\"\"); print $1\"-\"$2}' > deps.txt",
    "deps:licenses": "npx generate-license-file --input package.json --output licenses.txt"
  },
  "keywords": [
    "x402",
    "fab",
    "payment",
    "billing",
    "http-402",
    "fiat",
    "agent-pay"
  ],
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "@x402/core": ">=2.23.0 <3"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    }
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1147.0",
    "@aws-sdk/types": "^3.973.8",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-secrets-manager": "^3.1147.0",
    "@eslint/js": "9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "25.9.8",
    "@vitest/coverage-v8": "4.1.11",
    "@x402/core": ">=2.23.0 <3",
    "@x402/express": ">=2.23.0 <3",
    "eslint": "10.12.0",
    "express": "^4.18.2",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "tsup": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws/fiat-extension-for-x402.git"
  },
  "homepage": "https://github.com/aws/fiat-extension-for-x402#readme",
  "bugs": {
    "url": "https://github.com/aws/fiat-extension-for-x402/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

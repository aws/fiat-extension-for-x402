        "kid": "my-quote-key"
      },
      {
        "keyArn": "arn:aws:kms:us-east-1:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab",
        "kid": "key/1234abcd-12ab-34cd-56ef-1234567890ab"
      },
      {
        "keyArn": "1234abcd-12ab",
        "kid": "1234abcd-12ab"
      },
      {
        "keyArn": "alias/foo",
        "kid": "foo"
      }
    ]
  },
